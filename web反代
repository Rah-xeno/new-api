# ===== 前端静态文件（本地） =====

location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
}



location / {
    try_files $uri $uri/ /index.html;
    add_header Content-Security-Policy "default-src 'self';script-src 'self' https://www.linkbus.net;connect-src 'self' https://www.linkbus.net wss://www.linkbus.net;frame-src https://www.linkbus.net;style-src 'self' 'unsafe-inline';img-src 'self' data: https://chat.linkbus.net;worker-src 'self';" always;
}